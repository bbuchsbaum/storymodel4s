{
  "links": {
    "$defs": {
      "ConstructionLink": {
        "additionalProperties": false,
        "description": "Explicit links address admitted situations without caller-generated content IDs.",
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/$defs/ConstructionQuote"
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "key": {
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "kind": {
            "enum": [
              "part_of",
              "before",
              "causes",
              "references"
            ],
            "title": "Kind",
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/ConstructionRef"
          },
          "target": {
            "$ref": "#/$defs/ConstructionRef"
          }
        },
        "required": [
          "key",
          "kind",
          "source",
          "target",
          "evidence"
        ],
        "title": "ConstructionLink",
        "type": "object"
      },
      "ConstructionQuote": {
        "additionalProperties": false,
        "description": "A relation cites an exact quote in one of its endpoint observation rows.",
        "properties": {
          "quote": {
            "$ref": "#/$defs/Quote"
          },
          "row": {
            "minLength": 1,
            "title": "Row",
            "type": "string"
          }
        },
        "required": [
          "row",
          "quote"
        ],
        "title": "ConstructionQuote",
        "type": "object"
      },
      "ConstructionRef": {
        "additionalProperties": false,
        "description": "A name is qualified by its observation row, never guessed from a repeated label.",
        "properties": {
          "key": {
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "row": {
            "minLength": 1,
            "title": "Row",
            "type": "string"
          }
        },
        "required": [
          "row",
          "key"
        ],
        "title": "ConstructionRef",
        "type": "object"
      },
      "Quote": {
        "additionalProperties": false,
        "description": "Exact canonical UTF-16 evidence; the resolver checks the text independently.",
        "properties": {
          "span": {
            "$ref": "#/$defs/Span"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "span",
          "text"
        ],
        "title": "Quote",
        "type": "object"
      },
      "Span": {
        "additionalProperties": false,
        "description": "Half-open canonical UTF-16 support, never ordinary Python character indices.",
        "properties": {
          "end": {
            "minimum": 0,
            "title": "End",
            "type": "integer"
          },
          "start": {
            "minimum": 0,
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "Span",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "One atomic relation batch binds the complete original construction receipt.",
    "properties": {
      "construction_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Construction Sha256",
        "type": "string"
      },
      "reason": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reason"
      },
      "relations": {
        "default": [],
        "items": {
          "$ref": "#/$defs/ConstructionLink"
        },
        "title": "Relations",
        "type": "array"
      },
      "schema_version": {
        "const": "storymodel.construction-links/v1",
        "default": "storymodel.construction-links/v1",
        "title": "Schema Version",
        "type": "string"
      },
      "status": {
        "enum": [
          "completed",
          "search-limited",
          "not-attempted",
          "failed"
        ],
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "construction_sha256",
      "status"
    ],
    "title": "ConstructionLinks",
    "type": "object"
  },
  "result": {
    "$defs": {
      "AnchoredContext": {
        "additionalProperties": false,
        "description": "An old context kind with native evidence stays disjoint from the legacy text record.",
        "properties": {
          "evidence": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Support"
                },
                {
                  "$ref": "#/$defs/PlaybackSupport"
                }
              ]
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "reported",
              "believed",
              "intended"
            ],
            "title": "Kind",
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parent"
          },
          "side": {
            "enum": [
              "source",
              "recall"
            ],
            "title": "Side",
            "type": "string"
          }
        },
        "required": [
          "side",
          "kind",
          "evidence"
        ],
        "title": "AnchoredContext",
        "type": "object"
      },
      "Assessment": {
        "additionalProperties": false,
        "description": "Fidelity is conditional on one explicit reference hypothesis.",
        "properties": {
          "evidence": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Support"
            },
            "title": "Evidence",
            "type": "array"
          },
          "grade": {
            "anyOf": [
              {
                "enum": [
                  "supported",
                  "gist-detail-error",
                  "contradicted",
                  "recaller-inference",
                  "external",
                  "invented",
                  "unverifiable",
                  "misread"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Grade"
          },
          "hypothesis": {
            "minLength": 1,
            "title": "Hypothesis",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          },
          "severity": {
            "anyOf": [
              {
                "enum": [
                  "minor",
                  "major"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Severity"
          },
          "status": {
            "enum": [
              "pending",
              "completed",
              "unavailable",
              "refused"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "hypothesis",
          "status"
        ],
        "title": "Assessment",
        "type": "object"
      },
      "Binding": {
        "additionalProperties": false,
        "description": "Reference and conditional fidelity attach to an already admitted recall detail.",
        "properties": {
          "assessments": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Assessment"
            },
            "title": "Assessments",
            "type": "array"
          },
          "detail": {
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          },
          "reference": {
            "$ref": "#/$defs/Reference"
          }
        },
        "required": [
          "detail",
          "reference"
        ],
        "title": "Binding",
        "type": "object"
      },
      "Circumstance": {
        "additionalProperties": false,
        "description": "An evidenced time or manner phrase is not a measured time or an entity referent.",
        "properties": {
          "evidence": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Support"
                },
                {
                  "$ref": "#/$defs/PlaybackSupport"
                }
              ]
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "time",
              "manner"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "situation": {
            "minLength": 1,
            "title": "Situation",
            "type": "string"
          }
        },
        "required": [
          "situation",
          "kind",
          "label",
          "evidence"
        ],
        "title": "Circumstance",
        "type": "object"
      },
      "Context": {
        "additionalProperties": false,
        "description": "Narrated worlds and attributed content remain separate on each account side.",
        "properties": {
          "evidence": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Support"
            },
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "narrated",
              "reported",
              "believed",
              "intended"
            ],
            "title": "Kind",
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parent"
          },
          "side": {
            "enum": [
              "source",
              "recall"
            ],
            "title": "Side",
            "type": "string"
          }
        },
        "required": [
          "side",
          "kind"
        ],
        "title": "Context",
        "type": "object"
      },
      "Detail": {
        "additionalProperties": false,
        "description": "Recall content has occurrence identity independent of its later fidelity assessment.",
        "properties": {
          "address": {
            "enum": [
              "target",
              "other",
              "personal",
              "general",
              "unresolved",
              "extended"
            ],
            "title": "Address",
            "type": "string"
          },
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "discourse": {
            "default": "content",
            "enum": [
              "content",
              "commentary",
              "inference",
              "repair",
              "repetition"
            ],
            "title": "Discourse",
            "type": "string"
          },
          "event": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Event"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "event",
              "participant",
              "attribute",
              "temporal",
              "spatial",
              "perceptual",
              "dialogue",
              "mental",
              "relation",
              "knowledge",
              "discourse"
            ],
            "title": "Kind",
            "type": "string"
          },
          "support": {
            "$ref": "#/$defs/Support"
          },
          "unit": {
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "unit",
          "kind",
          "content",
          "support",
          "address"
        ],
        "title": "Detail",
        "type": "object"
      },
      "Document": {
        "additionalProperties": false,
        "description": "A named source edition or recall session and its exact canonical text.",
        "properties": {
          "canonicalization": {
            "const": "identity/v1",
            "default": "identity/v1",
            "title": "Canonicalization",
            "type": "string"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "key": {
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "side": {
            "enum": [
              "source",
              "recall"
            ],
            "title": "Side",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "key",
          "side",
          "text",
          "sha256"
        ],
        "title": "Document",
        "type": "object"
      },
      "Entity": {
        "additionalProperties": false,
        "description": "Document-local identity; v2 permits recall origins without source identity claims.\n\n``source_document`` is the retained wire name for the origin document, preserving IDs.",
        "properties": {
          "evidence": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Support"
                },
                {
                  "$ref": "#/$defs/PlaybackSupport"
                }
              ]
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "source_document": {
            "minLength": 1,
            "title": "Source Document",
            "type": "string"
          }
        },
        "required": [
          "source_document",
          "label",
          "evidence"
        ],
        "title": "Entity",
        "type": "object"
      },
      "Event": {
        "additionalProperties": false,
        "description": "An occurrence can group many details without making each detail an event.",
        "properties": {
          "context": {
            "minLength": 1,
            "title": "Context",
            "type": "string"
          },
          "evidence": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Support"
                },
                {
                  "$ref": "#/$defs/PlaybackSupport"
                }
              ]
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "participants": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Participation"
            },
            "title": "Participants",
            "type": "array"
          },
          "predicate": {
            "minLength": 1,
            "title": "Predicate",
            "type": "string"
          },
          "side": {
            "enum": [
              "source",
              "recall"
            ],
            "title": "Side",
            "type": "string"
          }
        },
        "required": [
          "side",
          "context",
          "predicate",
          "evidence"
        ],
        "title": "Event",
        "type": "object"
      },
      "ExtendedContext": {
        "additionalProperties": false,
        "description": "Additional v5 context kinds keep holderless possibility distinct from unattributed minds.",
        "properties": {
          "evidence": {
            "default": [],
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Support"
                },
                {
                  "$ref": "#/$defs/PlaybackSupport"
                }
              ]
            },
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "desire",
              "memory",
              "imagination",
              "hypothetical",
              "counterfactual"
            ],
            "title": "Kind",
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parent"
          },
          "side": {
            "enum": [
              "source",
              "recall"
            ],
            "title": "Side",
            "type": "string"
          }
        },
        "required": [
          "side",
          "kind"
        ],
        "title": "ExtendedContext",
        "type": "object"
      },
      "Hypothesis": {
        "additionalProperties": false,
        "description": "A single, joint, broad or external reference; no invented probability.",
        "properties": {
          "external": {
            "anyOf": [
              {
                "enum": [
                  "personal",
                  "general",
                  "other_episode"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "External"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "single",
              "joint",
              "broad",
              "external"
            ],
            "title": "Kind",
            "type": "string"
          },
          "targets": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Targets",
            "type": "array"
          }
        },
        "required": [
          "kind"
        ],
        "title": "Hypothesis",
        "type": "object"
      },
      "Inventory": {
        "additionalProperties": false,
        "description": "Explicit extraction completeness; zero details alone says nothing about processing.",
        "properties": {
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          },
          "status": {
            "enum": [
              "completed",
              "not-attempted",
              "failed",
              "search-limited"
            ],
            "title": "Status",
            "type": "string"
          },
          "unit": {
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "unit",
          "status"
        ],
        "title": "Inventory",
        "type": "object"
      },
      "MediaSource": {
        "additionalProperties": false,
        "description": "One fingerprinted edition stream on a declared primary clock, independent of its text.",
        "properties": {
          "axis_kind": {
            "default": "edition-playback",
            "enum": [
              "edition-playback",
              "annotation-timeline"
            ],
            "title": "Axis Kind",
            "type": "string"
          },
          "clock": {
            "minLength": 1,
            "title": "Clock",
            "type": "string"
          },
          "edition": {
            "minLength": 1,
            "title": "Edition",
            "type": "string"
          },
          "end_tick": {
            "title": "End Tick",
            "type": "string"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          },
          "key": {
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "seconds_per_tick": {
            "title": "Seconds Per Tick",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "side": {
            "enum": [
              "source",
              "recall"
            ],
            "title": "Side",
            "type": "string"
          },
          "start_tick": {
            "title": "Start Tick",
            "type": "string"
          },
          "stream": {
            "minLength": 1,
            "title": "Stream",
            "type": "string"
          },
          "stream_kind": {
            "enum": [
              "picture",
              "audio"
            ],
            "title": "Stream Kind",
            "type": "string"
          }
        },
        "required": [
          "key",
          "side",
          "sha256",
          "edition",
          "stream",
          "clock",
          "stream_kind",
          "start_tick",
          "end_tick",
          "seconds_per_tick"
        ],
        "title": "MediaSource",
        "type": "object"
      },
      "Participation": {
        "additionalProperties": false,
        "description": "An evidenced role assignment, distinct from entity identity.",
        "properties": {
          "entity": {
            "minLength": 1,
            "title": "Entity",
            "type": "string"
          },
          "evidence": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Support"
                },
                {
                  "$ref": "#/$defs/PlaybackSupport"
                }
              ]
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "role": {
            "enum": [
              "agent",
              "patient",
              "speaker",
              "recipient",
              "experiencer",
              "location"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "entity",
          "role",
          "evidence"
        ],
        "title": "Participation",
        "type": "object"
      },
      "PlaybackSupport": {
        "additionalProperties": false,
        "description": "Canonical interval union plus explicit points on one complete media-source identity.",
        "properties": {
          "intervals": {
            "default": [],
            "items": {
              "$ref": "#/$defs/TickInterval"
            },
            "title": "Intervals",
            "type": "array"
          },
          "points": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Points",
            "type": "array"
          },
          "source": {
            "minLength": 1,
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "title": "PlaybackSupport",
        "type": "object"
      },
      "Quote": {
        "additionalProperties": false,
        "description": "Exact canonical UTF-16 evidence; the resolver checks the text independently.",
        "properties": {
          "span": {
            "$ref": "#/$defs/Span"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "span",
          "text"
        ],
        "title": "Quote",
        "type": "object"
      },
      "Recipe": {
        "additionalProperties": false,
        "description": "A named derivation and its input digests, with no credential material.",
        "properties": {
          "input_sha256": {
            "items": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Input Sha256",
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "input_sha256"
        ],
        "title": "Recipe",
        "type": "object"
      },
      "Reference": {
        "additionalProperties": false,
        "description": "Reference processing status and reference outcome are orthogonal.",
        "properties": {
          "hypotheses": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Hypothesis"
            },
            "title": "Hypotheses",
            "type": "array"
          },
          "interpretation": {
            "default": "referent",
            "enum": [
              "narrative",
              "referent"
            ],
            "title": "Interpretation",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "enum": [
                  "resolved",
                  "alternative",
                  "unresolved"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
